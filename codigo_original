import datetime

e=[]

def add(n,q,p):
    global e
    i = {'nome':n,'qtd':q,'preco':p}
    e.append(i)
    print("produto",n,"cadastrado com sucesso!")

def add2(nome,qtd):
    for x in e:
        if x['nome']==nome:
            x['qtd']=x['qtd']+qtd
            print("estoque atualizado")
            return
    print("produto nao encontrado") 

def calc():
    t=0
    for x in e:
        t=t+(x['qtd']*x['preco'])
    return t

def lista():
    print("=====LISTA DE PRODUTOS=====")
    for x in e:
        print(x['nome'],'-','qtd:',x['qtd'],'-','preco: R$',x['preco'])
    print("============================")

def rem(n):
    global e 
    achou = 0
    for x in e:
        if x['nome']==n:
            e.remove(x)
            achou=1
            print("produto removido")
            break
    if achou == 0:
        print("produto nao encontrado")

def buscaBaixoEstoque():
    print("produtos com estoque baixo (menor que 5):")
    for x in e:
        if x['qtd']<5:
            print(x['nome'],"-","qtd",x['qtd'])


#programa principal

while True:

    print("\n1-Cadastrar produto")
    print("2-Adicionar estoque")
    print("3-Listar produtos")
    print("4-Remover produto")
    print("5-Valor total do estoque")
    print("6-Produtos com estoque baixo")
    print("0-Sair")
    op=input("Escolha uma opcao: ") 


    if op == "1":
        nome = input("nome do produto:")
        qtd = int(input("Quantidade:"))
        preco = float(input("Preco:"))
        add(nome,qtd,preco)

    elif op=="2":
        nome=input("Nome do produto: ")
        qtd=int(input("Quantidade a adicionar: "))
        add2(nome,qtd)
    elif op=="3":
        lista()
    elif op=="4":
        nome=input("Nome do produto a remover: ")
        rem(nome)
    elif op=="5":
        print("Valor total do estoque: R$",calc())
    elif op=="6":
        buscaBaixoEstoque()
    elif op=="0":
        print("saindo...")
        break
    else:
        print("opcao invalida!!")