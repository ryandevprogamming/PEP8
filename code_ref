"""
Sistema de Controle de Estoque
 
Permite cadastrar produtos, atualizar quantidades, listar o estoque,
remover produtos, calcular o valor total e identificar produtos
com estoque baixo.
"""

ESTOQUE_MINIMO = 5
 
 
def cadastrar_produto(estoque, nome, quantidade, preco):
    """Adiciona um novo produto ao estoque."""
    produto = {"nome": nome, "quantidade": quantidade, "preco": preco}
    estoque.append(produto)
    print(f"Produto '{nome}' cadastrado com sucesso!")
 
 
def atualizar_estoque(estoque, nome, quantidade_adicional):
    """Adiciona quantidade a um produto já existente no estoque."""
    for produto in estoque:
        if produto["nome"] == nome:
            produto["quantidade"] += quantidade_adicional
            print("Estoque atualizado com sucesso!")
            return
 
    print("Produto não encontrado.")

def remover_produto(estoque, nome):
    """Remove um produto do estoque pelo nome."""
    for produto in estoque:
        if produto["nome"] == nome:
            estoque.remove(produto)
            print("Produto removido com sucesso!")
            return
 
    print("Produto não encontrado.")
 
 
def calcular_valor_total(estoque):
    """Calcula o valor total do estoque somando quantidade * preço."""
    total = 0
    for produto in estoque:
        total += produto["quantidade"] * produto["preco"]
 
    return total
 
 
def listar_produtos(estoque):
    """Exibe todos os produtos cadastrados no estoque."""
    print("===== LISTA DE PRODUTOS =====")
 
    if not estoque:
        print("Nenhum produto cadastrado.")
    else:
        for produto in estoque:
            print(
                f"{produto['nome']} - qtd: {produto['quantidade']} "
                f"- preço: R$ {produto['preco']:.2f}"
            )
 
    print("==============================")


def listar_estoque_baixo(estoque, minimo=ESTOQUE_MINIMO):
    """Exibe produtos com quantidade abaixo do mínimo definido."""
    print(f"Produtos com estoque baixo (menor que {minimo}):")
    produtos_baixos = [p for p in estoque if p["quantidade"] < minimo]
 
    if not produtos_baixos:
        print("Nenhum produto com estoque baixo.")
    else:
        for produto in produtos_baixos:
            print(f"{produto['nome']} - qtd: {produto['quantidade']}")
 
 
def ler_inteiro(mensagem):
    """Solicita um número inteiro ao usuário, tratando entradas inválidas."""
    while True:
        try:
            return int(input(mensagem))
        except ValueError:
            print("Valor inválido. Digite um número inteiro.")
 
 
def ler_float(mensagem):
    """Solicita um número decimal ao usuário, tratando entradas inválidas."""
    while True:
        try:
            return float(input(mensagem))
        except ValueError:
            print("Valor inválido. Digite um número decimal.")
 
 
def exibir_menu():
    """Exibe as opções do menu principal."""
    print("\n1 - Cadastrar produto")
    print("2 - Adicionar estoque")
    print("3 - Listar produtos")
    print("4 - Remover produto")
    print("5 - Valor total do estoque")
    print("6 - Produtos com estoque baixo")
    print("0 - Sair")